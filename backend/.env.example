# ==============================================================================
# The Night Before - Environment Configuration Example
# Copy this file to .env and fill in your values
# ==============================================================================

# LLM Provider Configuration
# Supported providers: openai, groq, gemini, openrouter, ollama
LLM_PROVIDER=openai
LLM_MODEL_NAME=gpt-4o-mini

# API Keys (Set either OPENAI_API_KEY, GEMINI_API_KEY, or GROQ_API_KEY depending on provider)
OPENAI_API_KEY=your_openai_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here
# GROQ_API_KEY=your_groq_api_key_here

# Optional Custom Base URL (e.g. for Groq: https://api.groq.com/openai/v1 or local Ollama: http://localhost:11434/v1)
# LLM_BASE_URL=

# Model Parameters
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=800

# Retrieval & Grounding Thresholds
CHROMA_COLLECTION_NAME=course_materials
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
DEFAULT_TOP_K=5
RETRIEVAL_SIMILARITY_THRESHOLD=0.35

# Context & Conversation Controls
MAX_CONTEXT_CHUNKS=5
MAX_CONTEXT_CHARS=3500
MAX_CONVERSATION_TURNS=6
